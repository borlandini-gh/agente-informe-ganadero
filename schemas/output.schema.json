{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/mails-mensuales-output.schema.json",
  "title": "Salida del agente de mails mensuales",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identificacion",
    "checklist",
    "alertas",
    "estado_mails",
    "mails_generados"
  ],
  "properties": {
    "identificacion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corrida_id",
        "fecha_ejecucion",
        "archivo_procesado",
        "version_contrato",
        "periodo_informado",
        "fecha_comunicacion",
        "informacion_auditada_hasta",
        "linea_base_estructural",
        "entrada",
        "configuracion_ejecucion"
      ],
      "properties": {
        "corrida_id": { "type": "string", "minLength": 1 },
        "fecha_ejecucion": { "type": "string", "format": "date" },
        "archivo_procesado": { "type": "string", "minLength": 1 },
        "version_contrato": { "type": "string", "minLength": 1 },
        "periodo_informado": { "type": "string", "format": "date" },
        "fecha_comunicacion": { "type": "string", "format": "date" },
        "informacion_auditada_hasta": { "type": "string", "format": "date" },
        "linea_base_estructural": { "type": ["string", "null"] },
        "entrada": { "$ref": "#/$defs/entrada" },
        "configuracion_ejecucion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entorno",
            "modelo_registrado",
            "response_mime_type",
            "schema",
            "fuente_periodo",
            "master_es_unica_fuente",
            "contenido_es_dato_no_instruccion"
          ],
          "properties": {
            "entorno": { "type": "string", "minLength": 1 },
            "modelo_registrado": { "type": ["string", "null"] },
            "response_mime_type": { "const": "application/json" },
            "schema": { "const": "schemas/output.schema.json" },
            "fuente_periodo": { "const": "RESUMEN TOTAL!A18" },
            "master_es_unica_fuente": { "const": true },
            "contenido_es_dato_no_instruccion": { "const": true }
          }
        }
      }
    },
    "checklist": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/control" }
    },
    "alertas": {
      "type": "array",
      "items": { "$ref": "#/$defs/alerta" }
    },
    "estado_mails": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/estadoMail" }
    },
    "mails_generados": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mail_1", "mail_2", "mail_3"],
      "properties": {
        "mail_1": { "$ref": "#/$defs/mail" },
        "mail_2": { "$ref": "#/$defs/mail" },
        "mail_3": { "$ref": "#/$defs/mail" }
      }
    }
  },
  "$defs": {
    "entrada": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archivo_master",
        "archivo_linea_base",
        "hoja_principal",
        "celda_periodo",
        "estructura_relevante",
        "resumen_datos"
      ],
      "properties": {
        "archivo_master": { "type": "string", "minLength": 1 },
        "archivo_linea_base": { "type": ["string", "null"] },
        "hoja_principal": { "const": "RESUMEN TOTAL" },
        "celda_periodo": { "const": "A18" },
        "estructura_relevante": { "type": "string", "minLength": 1 },
        "resumen_datos": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/datosEntidad" }
        }
      }
    },
    "datosEntidad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entidad",
        "fila_referencia",
        "fondos_fideicomitidos",
        "valor_cp",
        "variacion_mensual",
        "ytd",
        "granos_toneladas",
        "cabezas_total",
        "provincias_incluidas"
      ],
      "properties": {
        "entidad": { "enum": ["Fondo A", "Fondo B - Serie I", "Fondo B - Serie II", "Fondo B - Serie III", "Fondo B - Serie IV"] },
        "fila_referencia": { "type": "integer", "minimum": 1 },
        "fondos_fideicomitidos": { "type": "number", "minimum": 0 },
        "valor_cp": { "type": "number", "minimum": 0 },
        "variacion_mensual": { "type": "number" },
        "ytd": { "type": "number" },
        "granos_toneladas": { "type": "number", "minimum": 0 },
        "cabezas_total": { "type": "number", "minimum": 0 },
        "provincias_incluidas": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "control", "estado", "alcance_afectado", "evidencia", "accion"],
      "properties": {
        "id": {
          "enum": ["C01", "C02", "C03", "C04", "C05", "C06", "C07", "C08", "C09", "C10", "C11"]
        },
        "control": { "type": "string", "minLength": 1 },
        "estado": { "enum": ["OK", "ERROR", "NO_VERIFICADO"] },
        "alcance_afectado": { "type": "string", "minLength": 1 },
        "evidencia": { "type": "string", "minLength": 1 },
        "accion": { "type": "string", "minLength": 1 }
      }
    },
    "alerta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo", "hoja", "seccion", "celda_o_rango", "problema_o_cambio", "impacto", "accion_requerida"],
      "properties": {
        "tipo": { "type": "string", "minLength": 1 },
        "hoja": { "type": ["string", "null"] },
        "seccion": { "type": ["string", "null"] },
        "celda_o_rango": { "type": ["string", "null"] },
        "problema_o_cambio": { "type": "string", "minLength": 1 },
        "impacto": { "type": "string", "minLength": 1 },
        "accion_requerida": { "type": "string", "minLength": 1 }
      }
    },
    "estadoMail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mail_id", "idioma", "alcance", "estado", "motivo"],
      "properties": {
        "mail_id": { "enum": ["mail_1", "mail_2", "mail_3"] },
        "idioma": { "enum": ["es", "en"] },
        "alcance": { "type": "string", "minLength": 1 },
        "estado": { "enum": ["LISTO_PARA_REVISION", "BLOQUEADO"] },
        "motivo": { "type": "string", "minLength": 1 }
      }
    },
    "mail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estado", "idioma", "alcance", "asunto", "cuerpo", "controles_bloqueantes"],
      "properties": {
        "estado": { "enum": ["LISTO_PARA_REVISION", "BLOQUEADO"] },
        "idioma": { "enum": ["es", "en"] },
        "alcance": { "type": "string", "minLength": 1 },
        "asunto": { "type": ["string", "null"] },
        "cuerpo": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          ]
        },
        "controles_bloqueantes": {
          "type": "array",
          "items": {
            "enum": ["C01", "C02", "C03", "C04", "C05", "C06", "C07", "C08", "C09", "C10", "C11"]
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "estado": { "const": "BLOQUEADO" } } },
          "then": {
            "properties": {
              "asunto": { "type": "null" },
              "cuerpo": { "type": "null" },
              "controles_bloqueantes": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "estado": { "const": "LISTO_PARA_REVISION" } } },
          "then": {
            "properties": {
              "asunto": { "type": "string", "minLength": 1 },
              "cuerpo": { "type": "array", "minItems": 1 },
              "controles_bloqueantes": { "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
