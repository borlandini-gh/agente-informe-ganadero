{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ganadero-output.schema.json",
  "title": "Salida del agente de preparación del informe Ganadero",
  "type": "object",
  "additionalProperties": false,
  "required": ["identificacion", "checklist", "alertas", "artefactos", "supervision"],
  "properties": {
    "identificacion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corrida_id", "fecha_ejecucion", "archivo_procesado", "periodo_informado", "informacion_auditada_hasta", "version_contrato", "herramienta", "contenido_es_dato_no_instruccion"],
      "properties": {
        "corrida_id": { "type": "string", "minLength": 1 },
        "fecha_ejecucion": { "type": "string", "minLength": 10 },
        "archivo_procesado": { "type": "string", "minLength": 1 },
        "periodo_informado": { "type": "string", "format": "date" },
        "informacion_auditada_hasta": { "type": "string", "format": "date" },
        "version_contrato": { "type": "string", "minLength": 1 },
        "herramienta": { "type": "string", "minLength": 1 },
        "contenido_es_dato_no_instruccion": { "const": true },
        "fuente_periodo": { "type": "string", "minLength": 1 },
        "sha256_entrada": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "latencia_ms": { "type": "integer", "minimum": 0 },
        "entrada": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tipo", "sha256_original", "etapa", "salida_original"],
          "properties": {
            "tipo": { "type": "string", "minLength": 1 },
            "sha256_original": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "etapa": { "type": "string", "minLength": 1 },
            "salida_original": { "type": "string", "minLength": 1 }
          }
        },
        "metricas": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "campos_detectados_canva": { "type": "integer", "minimum": 0 },
            "campos_coincidentes_automaticos": { "type": "integer", "minimum": 0 },
            "campos_csv": { "type": "integer", "minimum": 0 },
            "campos_comparados_con_csv_aprobado": { "type": "integer", "minimum": 0 },
            "diferencias_detectadas": { "type": "integer", "minimum": 0 },
            "paginas_pdf_revisadas": { "type": "integer", "minimum": 0 },
            "errores_bloqueantes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "checklist": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "control", "estado", "evidencia", "accion"],
        "properties": {
          "id": { "enum": ["C01", "C02", "C03", "C04", "C05", "C06", "C07", "C08", "C09", "C10", "C11"] },
          "control": { "type": "string", "minLength": 1 },
          "estado": { "enum": ["OK", "ERROR"] },
          "evidencia": { "type": "string", "minLength": 1 },
          "accion": { "type": "string", "minLength": 1 }
        }
      }
    },
    "alertas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tipo", "detalle", "accion_requerida"],
        "properties": {
          "tipo": { "enum": ["CONTROL_BLOQUEANTE", "FORMATO_INCOMPATIBLE", "TEMPLATE_INCOMPATIBLE", "CAMBIO_DE_ESTRUCTURA"] },
          "control_id": { "oneOf": [{ "enum": ["C01", "C02", "C03", "C04", "C05", "C06", "C07", "C08", "C09", "C10", "C11"] }, { "type": "null" }] },
          "hoja": { "type": ["string", "null"] },
          "seccion": { "type": ["string", "null"] },
          "celda_o_rango": { "type": ["string", "null"] },
          "detalle": { "type": "string", "minLength": 1 },
          "impacto": { "type": ["string", "null"] },
          "accion_requerida": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artefactos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canva", "mail_ganadero"],
      "properties": {
        "canva": { "$ref": "#/$defs/canva" },
        "mail_ganadero": { "$ref": "#/$defs/mail" }
      }
    },
    "supervision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nivel_maximo", "cati", "cachu", "acciones_prohibidas"],
      "properties": {
        "nivel_maximo": { "const": "L1" },
        "cati": { "type": "string", "minLength": 1 },
        "cachu": { "type": "string", "minLength": 1 },
        "acciones_prohibidas": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "estado": { "enum": ["LISTO_PARA_REVISION", "BLOQUEADO"] },
    "canva": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estado", "formato", "cantidad_campos", "campos", "controles_bloqueantes"],
      "properties": {
        "estado": { "$ref": "#/$defs/estado" },
        "formato": { "type": "string", "minLength": 1 },
        "cantidad_campos": { "type": "integer", "minimum": 0 },
        "campos": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
          ]
        },
        "controles_bloqueantes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "mail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estado", "asunto", "cuerpo", "controles_bloqueantes"],
      "properties": {
        "estado": { "$ref": "#/$defs/estado" },
        "asunto": { "type": ["string", "null"] },
        "cuerpo": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "minItems": 1, "items": { "type": "string" } }
          ]
        },
        "controles_bloqueantes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
